GOOGLE_API_KEY=<<your_gemini_api_key_here>>

# Required for the duplicate-check/publish steps: MongoDB Atlas connection string.
# See README.md "Setup" (or Ai_Agent_new's README) for how to create a free cluster and get this.
MONGO_URI=<<your_mongodb_atlas_connection_string_here>>

# Optional: set LANGSMITH_TRACING=true and fill these in if you want tracing
LANGSMITH_API_KEY=<<your_langsmith_api_key_here>>
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=<<your_project_name_here>>
